# =============================================================================
# Day 1 - Streaming FIR Accelerator
#   make sw      build the host/driver/reference software and generate vectors
#   make sim     run the Icarus differential testbench (default via `all`)
#   make metrics regenerate results/metrics.md from the run
#   make elab    elaborate the RTL at three distinct parameter sets
#   make synth   report cell/FF area (analytical; Yosys not present here)
#   make formal  formal check (SymbiYosys not present here; see note)
#   make all     sw -> sim -> metrics
#   make clean   remove build artifacts
# =============================================================================

# ---- design parameters (single source of truth for RTL, SW and vectors) ----
DATA_WIDTH ?= 16
COEF_WIDTH ?= 16
TAPS       ?= 8
FIFO_DEPTH ?= 16
LEN_WIDTH  ?= 16
ADDR_WIDTH ?= 8

# ---- stimulus controls ----
NJOBS      ?= 24
MAX_LEN    ?= 48
SEED       ?= 12345

# ---- tools ----
CC        ?= cc
CFLAGS    ?= -std=c11 -O2 -Wall -Wextra
IVERILOG  ?= iverilog
VVP       ?= vvp
PYTHON    ?= python3

RTL      := $(wildcard rtl/*.v)
TB       := tb/fir_tb.sv
VEC      := tb/vectors
PARAMS   := $(VEC)/params.vh
JOBS     := $(VEC)/jobs.txt
HOST     := sw/fir_host
SIM      := results/fir_sim.vvp

.PHONY: all sim sw vectors metrics elab synth formal clean

all: sim metrics

# ---------------- software: host / driver / reference ----------------
$(HOST): sw/fir_host.c sw/fir_driver.c sw/fir_ref.c sw/fir_accel.h
	$(CC) $(CFLAGS) -o $@ sw/fir_host.c sw/fir_driver.c sw/fir_ref.c

sw: $(HOST)

# ---------------- generated parameter header ----------------
$(PARAMS): Makefile
	@mkdir -p $(VEC)
	@{ echo "// auto-generated by Makefile - do not edit"; \
	   echo "localparam integer DATA_WIDTH = $(DATA_WIDTH);"; \
	   echo "localparam integer COEF_WIDTH = $(COEF_WIDTH);"; \
	   echo "localparam integer TAPS       = $(TAPS);"; \
	   echo "localparam integer FIFO_DEPTH = $(FIFO_DEPTH);"; \
	   echo "localparam integer LEN_WIDTH  = $(LEN_WIDTH);"; \
	   echo "localparam integer ADDR_WIDTH = $(ADDR_WIDTH);"; } > $@
	@echo "generated $@"

# ---------------- test vectors + golden ----------------
$(JOBS): $(HOST)
	@mkdir -p $(VEC)
	./$(HOST) --taps $(TAPS) --data-width $(DATA_WIDTH) --coef-width $(COEF_WIDTH) \
	          --fifo-depth $(FIFO_DEPTH) --njobs $(NJOBS) --max-len $(MAX_LEN) \
	          --seed $(SEED) --outdir $(VEC)

vectors: $(JOBS) $(PARAMS)

# ---------------- simulation ----------------
$(SIM): $(RTL) $(TB) $(PARAMS)
	@mkdir -p results
	$(IVERILOG) -g2012 -Wall -o $@ -s fir_tb -I$(VEC) $(RTL) $(TB)

sim: vectors $(SIM)
	@mkdir -p results
	$(VVP) $(SIM) | tee results/sim.log
	@if grep -q "TEST FAILED" results/sim.log; then echo "SIMULATION FAILED"; exit 1; fi
	@if ! grep -q "TEST PASSED" results/sim.log; then echo "NO PASS MARKER"; exit 1; fi

# ---------------- metrics ----------------
metrics:
	$(PYTHON) scripts/extract_metrics.py results/sim.log $(VEC)/sw_metrics.txt > results/metrics.md
	@echo "wrote results/metrics.md"

# ---------------- elaboration at three parameter sets ----------------
elab:
	@bash scripts/elaborate.sh

# ---------------- synthesis / area ----------------
# Yosys is not installed in this environment; scripts/area_estimate.py prints an
# analytical gate/FF estimate from the parameters instead (see README section 9).
synth:
	@if command -v yosys >/dev/null 2>&1; then \
	   yosys -q -p "read_verilog $(RTL); hierarchy -top fir_accel_top; synth -top fir_accel_top; stat" ; \
	 else \
	   echo "yosys not found - using analytical area estimate"; \
	   $(PYTHON) scripts/area_estimate.py --data-width $(DATA_WIDTH) --coef-width $(COEF_WIDTH) \
	       --taps $(TAPS) --fifo-depth $(FIFO_DEPTH) ; \
	 fi

# ---------------- formal ----------------
formal:
	@if command -v sby >/dev/null 2>&1; then \
	   echo "run: sby -f formal/fir.sby (property file provided as a stub)"; \
	 else \
	   echo "SymbiYosys (sby) not installed in this environment."; \
	   echo "The FIFO full/empty exclusivity and accumulator-width no-overflow"; \
	   echo "properties are instead covered by the directed saturation corner"; \
	   echo "cases in the differential testbench (see README section 10)."; \
	 fi

clean:
	rm -f $(HOST) $(SIM)
	rm -f $(VEC)/*.hex $(VEC)/jobs.txt $(VEC)/sw_metrics.txt $(PARAMS)
	rm -f results/*.vcd results/sim.log results/metrics.md
