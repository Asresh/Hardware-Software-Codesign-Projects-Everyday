# =============================================================================
# Day 2 - Systolic GEMM Accelerator
#   make sw      build the host/driver/reference software and generate vectors
#   make sim     run the Icarus differential testbench (default via `all`)
#   make metrics regenerate results/metrics.md from the run
#   make elab    elaborate the RTL at three distinct parameter sets
#   make synth   report cell/FF area (analytical; Yosys not present here)
#   make all     sw -> sim -> metrics
#   make clean   remove build artifacts
# =============================================================================

# ---- design parameters (single source of truth for RTL, SW and vectors) ----
N          ?= 8
DATA_WIDTH ?= 8
ACC_WIDTH  ?= 32
KMAX       ?= 64
ADDR_WIDTH ?= 16

# ---- stimulus controls ----
NRAND      ?= 256
SEED       ?= 12345

# ---- tools ----
CC        ?= cc
CFLAGS    ?= -std=c11 -O2 -Wall -Wextra
IVERILOG  ?= iverilog
VVP       ?= vvp
PYTHON    ?= python3

RTL      := $(wildcard rtl/*.v)
TB       := tb/gemm_tb.sv
VEC      := tb/vectors
PARAMS   := $(VEC)/params.vh
JOBS     := $(VEC)/jobs.txt
HOST     := sw/gemm_host
SIM      := results/gemm_sim.vvp

.PHONY: all sim sw vectors metrics elab synth clean

all: sim metrics

# ---------------- software: host / driver / reference ----------------
$(HOST): sw/gemm_host.c sw/gemm_driver.c sw/gemm_ref.c sw/gemm_accel.h
	$(CC) $(CFLAGS) -o $@ sw/gemm_host.c sw/gemm_driver.c sw/gemm_ref.c

sw: $(HOST)

# ---------------- generated parameter header ----------------
$(PARAMS): Makefile
	@mkdir -p $(VEC)
	@{ echo "// auto-generated by Makefile - do not edit"; \
	   echo "localparam integer N          = $(N);"; \
	   echo "localparam integer DATA_WIDTH = $(DATA_WIDTH);"; \
	   echo "localparam integer ACC_WIDTH  = $(ACC_WIDTH);"; \
	   echo "localparam integer KMAX       = $(KMAX);"; \
	   echo "localparam integer ADDR_WIDTH = $(ADDR_WIDTH);"; } > $@
	@echo "generated $@"

# ---------------- test vectors + golden ----------------
$(JOBS): $(HOST)
	@mkdir -p $(VEC)
	./$(HOST) --n $(N) --data-width $(DATA_WIDTH) --acc-width $(ACC_WIDTH) \
	          --kmax $(KMAX) --nrand $(NRAND) --seed $(SEED) --outdir $(VEC)

vectors: $(JOBS) $(PARAMS)

# ---------------- simulation ----------------
$(SIM): $(RTL) $(TB) $(PARAMS)
	@mkdir -p results
	$(IVERILOG) -g2012 -Wall -o $@ -s gemm_tb -I$(VEC) $(RTL) $(TB)

sim: vectors $(SIM)
	@mkdir -p results
	$(VVP) $(SIM) | tee results/sim.log
	@if grep -q "TEST FAILED" results/sim.log; then echo "SIMULATION FAILED"; exit 1; fi
	@if ! grep -q "TEST PASSED" results/sim.log; then echo "NO PASS MARKER"; exit 1; fi

# ---------------- metrics ----------------
metrics:
	$(PYTHON) scripts/extract_metrics.py results/sim.log $(VEC)/sw_metrics.txt > results/metrics.md
	@echo "wrote results/metrics.md"

# ---------------- elaboration at three parameter sets ----------------
elab:
	@bash scripts/elaborate.sh

# ---------------- synthesis / area ----------------
# Yosys is not installed in this environment; scripts/area_estimate.py prints an
# analytical gate/FF estimate from the parameters instead (see README section 9).
synth:
	@if command -v yosys >/dev/null 2>&1; then \
	   yosys -q -p "read_verilog $(RTL); hierarchy -top gemm_top; synth -top gemm_top; stat" ; \
	 else \
	   echo "yosys not found - using analytical area estimate"; \
	   $(PYTHON) scripts/area_estimate.py --n $(N) --data-width $(DATA_WIDTH) \
	       --acc-width $(ACC_WIDTH) --kmax $(KMAX) ; \
	 fi

clean:
	rm -f $(HOST) $(SIM)
	rm -f $(VEC)/*.hex $(VEC)/jobs.txt $(VEC)/sw_metrics.txt $(PARAMS)
	rm -f results/*.vcd results/sim.log results/metrics.md
